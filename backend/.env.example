# Application
APP_NAME=Multi-LLM Custom ChatGPT
APP_VERSION=0.1.0
API_PREFIX=/api

# CORS origins for the local Vite development server.
# Comma-separated list. Do not use "*" in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared LLM request limits
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048

# LLM provider keys. Leave empty to start the backend without a provider configured.
# Never commit real keys. Never put these values in the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
